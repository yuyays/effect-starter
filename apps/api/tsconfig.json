{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "plugins": [
      {
        "name": "@effect/language-service",
        "includeSuggestionsInTsc": false,
        "ignoreEffectWarningsInTscExitCode": true,
        "ignoreEffectErrorsInTscExitCode": false,
        "allowedUnstableApis": [
          "effect/http",
          "effect/http-api",
          "effect/sql",
          "@effect/platform-node",
          "@effect/sql-pg",
          "@effect/vitest"
        ],
        "effectFn": ["inferred-span", "suggested-span"],
        "diagnosticSeverity": {
          "floatingEffect": "error",
          "effectFnOpportunity": "error",
          "tryCatchInEffectGen": "error",
          "runEffectInsideEffect": "error",
          "promiseInEffectSuccess": "error",
          "lazyPromiseInEffectSync": "error",
          "effectInVoidSuccess": "error",
          "returnEffectInGen": "error",
          "scopeInLayerEffect": "error",
          "leakingRequirements": "error",
          "unsafeEffectTypeAssertion": "error"
        },
        "overrides": [
          {
            "include": ["**/*.test.ts", "**/*.spec.ts"],
            "options": {
              "diagnosticSeverity": {
                "effectFnOpportunity": "off"
              }
            }
          }
        ]
      }
    ]
  },
  "include": ["src", "drizzle.config.ts"]
}
