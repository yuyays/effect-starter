{
  "name": "@effect-starter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run build && node dev.js",
    "build": "vp run @effect-starter/contracts#build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@effect-starter/contracts": "workspace:*",
    "@effect/platform-node": "^4.0.0",
    "@effect/sql-pg": "^4.0.0",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "^4.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "esbuild": "0.28.1",
    "vite-plus": "1.0.0"
  }
}
