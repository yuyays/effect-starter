{
  "name": "@effect-starter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --target node24 --out-dir dist --clean",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@effect-starter/contracts": "workspace:*",
    "@effect/platform-node": "^4.0.0",
    "@effect/sql-pg": "^4.0.0",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "^4.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
