{
  "name": "effect-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "scaffold": "node packages/create-effect-starter/build-template.js && node packages/create-effect-starter/cli.js",
    "dev:web": "pnpm --filter @effect-starter/web dev",
    "dev:api": "pnpm --filter @effect-starter/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint .",
    "lint:type-aware": "oxlint . --type-aware",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "prepare": "effect-tsgo patch --typescript"
  },
  "devDependencies": {
    "@effect/tsgo": "0.48.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0"
}
