{
  "name": "effect-starter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/create-effect-starter/frontends/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run @effect-starter/contracts#build && vp run --filter \"@effect-starter/*\" --parallel dev",
    "create:app": "node packages/create-effect-starter/build-template.js && node packages/create-effect-starter/cli.js",
    "dev:web": "vp run @effect-starter/contracts#build && vp run --filter @effect-starter/web --filter @effect-starter/contracts --parallel dev",
    "dev:api": "vp run @effect-starter/contracts#build && vp run --filter @effect-starter/api --filter @effect-starter/contracts --parallel dev",
    "build": "vp run --filter \"@effect-starter/*\" build",
    "typecheck": "vp run @effect-starter/contracts#build && vp run --filter \"@effect-starter/*\" typecheck",
    "test": "vp run @effect-starter/contracts#build && vp run --filter \"@effect-starter/*\" test && node packages/create-effect-starter/build-template.js && node --test packages/create-effect-starter/create-project.test.js packages/create-effect-starter/install.test.js",
    "lint": "vp lint .",
    "format:check": "vp fmt . --check",
    "prepare": "effect-tsgo patch --typescript",
    "db:generate": "vp run @effect-starter/api#db:generate",
    "db:migrate": "vp run @effect-starter/api#db:migrate",
    "db:studio": "vp run @effect-starter/api#db:studio",
    "test:generated": "node packages/create-effect-starter/build-template.js && node packages/create-effect-starter/verify-generated.js"
  },
  "devDependencies": {
    "@effect/tsgo": "0.56.1",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.28.6"
}
