{
  "name": "effect-starter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "examples/durable-agent",
    "packages/*",
    "packages/create-effect-starter/frontends/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run --filter \"@effect-starter/*\" --parallel dev",
    "create:app": "node packages/create-effect-starter/build-template.js && node packages/create-effect-starter/cli.js",
    "dev:web": "vp run --filter @effect-starter/web dev",
    "dev:api": "vp run --filter @effect-starter/api dev",
    "build": "vp run --filter \"@effect-starter/*\" build",
    "start:api": "vp run @effect-starter/api#start",
    "typecheck": "vp run --cache --concurrency-limit 4 --filter \"@effect-starter/*\" typecheck",
    "typecheck:examples": "vp run --filter \"@effect-starter-examples/*\" typecheck",
    "test:examples": "vp run --filter \"@effect-starter-examples/*\" test",
    "test": "vp run --filter \"@effect-starter/*\" test && effect-tsgo patch --oxlint && node --test tools/effect-policy.test.js && node packages/create-effect-starter/build-template.js && node --test packages/create-effect-starter/create-project.test.js packages/create-effect-starter/install.test.js packages/create-effect-starter/dev-servers.test.js && vp run --filter \"@effect-starter-templates/vue\" test",
    "test:browser": "vp run --filter \"@effect-starter/*\" test:browser",
    "browser:install": "vp run --filter \"@effect-starter/*\" browser:install",
    "lint": "effect-tsgo patch --oxlint && vp lint .",
    "format:check": "vp fmt . --check",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "db:generate": "vp run @effect-starter/api#db:generate",
    "db:migrate": "vp run @effect-starter/api#db:migrate",
    "db:studio": "vp run @effect-starter/api#db:studio",
    "test:generated": "node packages/create-effect-starter/build-template.js && node packages/create-effect-starter/verify-generated.js"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.1",
    "@oxlint/plugins": "1.91.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.28.6"
}
